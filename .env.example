# FlashRecall configuration — copy this file to `.env` and edit.
# Both `node server/index.js` and `docker compose` read `.env` automatically.
# Real environment variables take precedence over values in `.env`.

# Port the server listens on locally; with Docker Compose, the host port
# that gets published (the container always listens on 3000 internally).
RECALL_PORT=3000

# Set to false to close sign-ups (no exceptions); true to reopen them.
# Apply changes with `docker compose up -d` — `restart` won't re-read .env.
REGISTRATION_OPEN=true

# Where the SQLite database lives. With Docker Compose this host directory
# is bind-mounted at /data inside the container.
RECALL_DATA_DIR=./data

# Docker Compose only: the user the container runs as. 1000 suits rootful
# Docker; under rootless Docker use 0 (which maps to your own host user).
# RECALL_UID=1000
# RECALL_GID=1000
